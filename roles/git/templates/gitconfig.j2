[credential "https://github.com"]
helper = !{{ check_os_brew_base_path }}/bin/gh auth git-credential
[credential "https://gist.github.com"]
helper = !{{ check_os_brew_base_path }}/bin/gh auth git-credential
[user]
name = {{ git_user_name }}
email = {{ git_user_email }}
{% if not git_sdplane %}
signingkey = {{ ansible_facts.user_dir }}/.ssh/id_ed25519.pub
[gpg]
format = ssh
[gpg "ssh"]
allowedSignersFile = {{ ansible_facts.user_dir }}/.ssh/allowed_signers
[commit]
gpgsign = true
[http]
cookiefile = {{ ansible_facts.user_dir }}/.gitcookies
{% endif %}
[core]
editor = code --wait
[pull]
rebase = true
[init]
defaultBranch = main
