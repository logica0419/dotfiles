[credential "https://github.com"]
helper = !{{ check_os_brew_base_path }}/bin/gh auth git-credential
[credential "https://gist.github.com"]
helper = !{{ check_os_brew_base_path }}/bin/gh auth git-credential
[user]
name = {{ git_user_name }}
email = {{ git_user_email }}
signingkey = {{ git_signing_key_path }}
[gpg]
format = ssh
[gpg "ssh"]
allowedSignersFile = {{ ansible_facts.user_dir }}/.ssh/allowed_signers
[commit]
gpgsign = true
[http]
cookiefile = {{ ansible_facts.user_dir }}/.gitcookies
[core]
editor = code --wait
[pull]
rebase = true
[init]
defaultBranch = main
